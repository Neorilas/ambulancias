# ============================================================
# ENTORNO LOCAL — copiar a backend/.env
#
# Apunta al MySQL de docker-compose.local.yml (puerto 3307 del host).
# Las contraseñas de aquí son las del contenedor local y no valen para nada
# fuera de esta máquina: por eso este fichero sí se versiona.
#
#   docker compose -f docker-compose.local.yml up -d
#   cd backend && cp .env.local.example .env && npm run dev
# ============================================================

# --- Servidor ---
NODE_ENV=development
APP_ENV=local
PORT=3001
API_VERSION=v1

# --- Base de datos (contenedor ambulancia-local-mysql) ---
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=ambulancia_local
DB_USER=ambulancia_local
DB_PASSWORD=local_dev
DB_POOL_MIN=2
DB_POOL_MAX=10

# --- JWT ---
# Secretos de juguete: distintos de los de PRE y producción para que un token
# de local no valga en ningún otro sitio. Regenerar con:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=local_solo_para_desarrollo_no_usar_fuera_de_esta_maquina_0001
JWT_REFRESH_SECRET=local_solo_para_desarrollo_no_usar_fuera_de_esta_maquina_0002
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# --- Archivos / Uploads ---
UPLOADS_DIR=./uploads
MAX_FILE_SIZE_MB=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# --- CORS (el dev server de Vite) ---
CORS_ORIGIN=http://localhost:5173

# --- Rate Limiting ---
# Más holgado que en producción: probando a mano se llega al tope enseguida.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=5000
RATE_LIMIT_MAX_ANON=1000
UPLOAD_RATE_LIMIT_MAX=200
LOGIN_RATE_LIMIT_MAX=50
LOGIN_RATE_LIMIT_WINDOW_MS=900000
ACCOUNT_LOCKOUT_ATTEMPTS=20
ACCOUNT_LOCKOUT_DURATION_MINUTES=1

# --- Logging ---
LOG_LEVEL=debug
LOG_DIR=./logs

# --- Bcrypt (4 rondas: en local interesa que el login sea instantáneo) ---
BCRYPT_ROUNDS=4
