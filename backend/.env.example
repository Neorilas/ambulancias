# ============================================================
# CONFIGURACIÓN DEL SERVIDOR - Copiar a .env y rellenar
# NUNCA subir .env a control de versiones
# ============================================================

# --- Servidor ---
NODE_ENV=development
PORT=3001
API_VERSION=v1

# --- Base de datos MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ambulancia_db
DB_USER=ambulancia_user
DB_PASSWORD=CAMBIAR_PASSWORD_SEGURO
DB_POOL_MIN=2
DB_POOL_MAX=10

# --- JWT ---
# Generar con: node -e "require('crypto').randomBytes(64).toString('hex')|xargs echo"
JWT_ACCESS_SECRET=CAMBIAR_POR_SECRET_64_BYTES_ALEATORIO
JWT_REFRESH_SECRET=CAMBIAR_POR_OTRO_SECRET_64_BYTES_ALEATORIO
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# --- Archivos / Uploads ---
UPLOADS_DIR=./uploads
MAX_FILE_SIZE_MB=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# --- CORS ---
# En producción, poner solo el dominio del frontend
CORS_ORIGIN=http://localhost:5173

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
# Cupo por USUARIO autenticado (no por IP: la oficina y el NAT del
# operador hacen que varios técnicos compartan una sola IP pública)
RATE_LIMIT_MAX_REQUESTS=600
# Cupo por IP para tráfico sin token válido
RATE_LIMIT_MAX_ANON=100
# Subida de fotos por minuto y usuario (un servicio son 12)
UPLOAD_RATE_LIMIT_MAX=60
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MS=900000
ACCOUNT_LOCKOUT_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION_MINUTES=30

# --- Avisos Web Push (VAPID) ---
# Generar UNA vez por entorno:  npx web-push generate-vapid-keys
# NUNCA commitear las claves reales: este repositorio es publico. Guardar copia
# en el gestor de contrasenas — si se pierde la privada, todas las
# suscripciones de los moviles dejan de valer y cada admin tiene que volver a
# pulsar «Activar avisos» en su perfil.
# Si se dejan vacias, los avisos quedan apagados y el resto de la app funciona.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contacto que exige el RFC 8292 (mailto: o URL)
VAPID_SUBJECT=mailto:soporte@vapss.net
# Altas/bajas/pruebas de avisos por minuto y usuario
PUSH_RATE_LIMIT_MAX=20
# Minutos de margen sobre la hora prevista antes de avisar a los admins de que
# nadie ha iniciado la asignacion (push + alarma sonora en la app). Vacio = 15.
# Bajarlo a 1 o 2 es la forma de probar el aviso en local sin esperar.
AVISO_SIN_INICIAR_MINUTOS=15

# --- Cartrack (mapa de flota, solo superadmin) ---
# API de la flota. Credenciales HTTP Basic de Cartrack. NUNCA en el repo, que
# es publico: van solo en el .env de cada servidor. Vacias = mapa apagado y el
# resto de la app funciona igual.
# OJO con la region: con la URL de otro pais las mismas credenciales dan 401.
CARTRACK_USER=
CARTRACK_KEY=
CARTRACK_BASE_URL=https://fleetapi-es.cartrack.com/rest
# Vida de la cache compartida en ms. Cartrack limita /vehicles/status a 60
# llamadas/min y el limite es de la CUENTA: con la cache son ~2/min haya quien
# haya mirando el mapa. Subirlo solo si llegan avisos de limite.
CARTRACK_CACHE_MS=30000
# Cuanto se espera a Cartrack antes de darlo por perdido (ms)
CARTRACK_TIMEOUT_MS=8000

# --- Logging ---
LOG_LEVEL=debug
LOG_DIR=./logs

# --- Bcrypt ---
BCRYPT_ROUNDS=12
